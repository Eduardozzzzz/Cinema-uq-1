<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.cinemauq.viewController.AdministrarPeliculasViewController"
      spacing="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button text="Volver al menú" onAction="#onVolver"/>
        <Label text="Administrar películas"/>
    </HBox>
    <Separator/>
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="6.0" prefWidth="280.0" minWidth="260.0">
            <Label text="Código"/>
            <TextField fx:id="txtCodigo" maxWidth="Infinity"/>
            <Label text="Nombre"/>
            <TextField fx:id="txtNombre" maxWidth="Infinity"/>
            <Label text="Género"/>
            <TextField fx:id="txtGenero" maxWidth="Infinity"/>
            <Label text="Duración en minutos"/>
            <TextField fx:id="txtDuracion" maxWidth="Infinity"/>
            <Label text="Clasificación"/>
            <ComboBox fx:id="cmbClasificacion" maxWidth="Infinity"/>
            <HBox spacing="8.0">
                <Button text="Agregar" onAction="#onAgregar"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
            </HBox>
            <HBox spacing="8.0">
                <Button text="Deshabilitar" onAction="#onDeshabilitar"/>
                <Button text="Limpiar" onAction="#onLimpiar"/>
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Cartelera"/>
            <TableView fx:id="tblPeliculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tbcCodigo" text="Código" prefWidth="90.0"/>
                    <TableColumn fx:id="tbcNombre" text="Nombre" prefWidth="220.0"/>
                    <TableColumn fx:id="tbcGenero" text="Género" prefWidth="150.0"/>
                    <TableColumn fx:id="tbcDuracion" text="Duración" prefWidth="90.0"/>
                    <TableColumn fx:id="tbcClasificacion" text="Clasificación" prefWidth="130.0"/>
                    <TableColumn fx:id="tbcEstado" text="Estado" prefWidth="120.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
