<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.cinemauq.viewController.VentaViewController"
      spacing="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button text="Volver al menú" onAction="#onVolver"/>
        <Label text="Venta de entrada"/>
    </HBox>
    <Separator/>
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" prefWidth="300.0">
            <Label text="Cliente"/>
            <ComboBox fx:id="cmbCliente" maxWidth="Infinity"/>
            <Label text="Función"/>
            <ComboBox fx:id="cmbFuncion" maxWidth="Infinity"/>
            <Label text="Asiento disponible"/>
            <ComboBox fx:id="cmbAsiento" maxWidth="Infinity"/>
            <Label text="Valor a pagar"/>
            <Label fx:id="lblValor"/>
            <Button text="Vender entrada" maxWidth="Infinity" onAction="#onVender"/>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Ventas registradas"/>
            <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tbcCodigo" text="Código" prefWidth="80.0"/>
                    <TableColumn fx:id="tbcCliente" text="Cliente" prefWidth="180.0"/>
                    <TableColumn fx:id="tbcPelicula" text="Película" prefWidth="200.0"/>
                    <TableColumn fx:id="tbcAsiento" text="Asiento" prefWidth="90.0"/>
                    <TableColumn fx:id="tbcValor" text="Valor" prefWidth="110.0"/>
                    <TableColumn fx:id="tbcEstado" text="Estado" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
