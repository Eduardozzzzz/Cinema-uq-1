<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.cinemauq.viewController.DisponibilidadViewController"
      spacing="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button text="Volver al menú" onAction="#onVolver"/>
        <Label text="Disponibilidad de una función"/>
    </HBox>
    <Separator/>
    <HBox spacing="24.0" VBox.vgrow="ALWAYS">
        <VBox spacing="8.0" prefWidth="280.0" minWidth="260.0">
            <Label text="Función"/>
            <ComboBox fx:id="cmbFuncion" maxWidth="Infinity"/>
            <Label text="Asientos"/>
            <HBox spacing="20.0">
                <VBox>
                    <Label text="Total"/>
                    <Label fx:id="lblTotal"/>
                </VBox>
                <VBox>
                    <Label text="Libres"/>
                    <Label fx:id="lblDisponibles"/>
                </VBox>
                <VBox>
                    <Label text="Ocupados"/>
                    <Label fx:id="lblOcupados"/>
                </VBox>
            </HBox>
            <Label fx:id="lblAsiento" wrapText="true"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Mapa de la sala"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <TilePane fx:id="tileAsientos" hgap="6.0" vgap="6.0" prefColumns="10"/>
            </ScrollPane>
            <Label text="Los asientos ocupados aparecen deshabilitados"/>
        </VBox>
    </HBox>
</VBox>
