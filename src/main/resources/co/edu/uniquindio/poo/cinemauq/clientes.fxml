<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.cinemauq.viewController.AdministrarClientesViewController"
      spacing="12.0">
    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Button text="Volver al menú" onAction="#onVolver"/>
        <Label text="Administrar clientes"/>
    </HBox>
    <Separator/>
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox spacing="6.0" prefWidth="280.0" minWidth="260.0">
            <Label text="Identificación"/>
            <TextField fx:id="txtIdentificacion" maxWidth="Infinity"/>
            <Label text="Nombre"/>
            <TextField fx:id="txtNombre" maxWidth="Infinity"/>
            <Label text="Tipo de cliente"/>
            <ComboBox fx:id="cmbTipoCliente" maxWidth="Infinity"/>
            <HBox spacing="8.0">
                <Button text="Agregar" onAction="#onAgregar"/>
                <Button text="Actualizar" onAction="#onActualizar"/>
            </HBox>
            <Button text="Limpiar" onAction="#onLimpiar"/>
            <Label fx:id="lblMensaje" wrapText="true"/>
        </VBox>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <Label text="Clientes registrados"/>
            <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tbcIdentificacion" text="Identificación" prefWidth="150.0"/>
                    <TableColumn fx:id="tbcNombre" text="Nombre" prefWidth="250.0"/>
                    <TableColumn fx:id="tbcTipoCliente" text="Tipo de cliente" prefWidth="150.0"/>
                    <TableColumn fx:id="tbcValor" text="Valor de la entrada" prefWidth="150.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
