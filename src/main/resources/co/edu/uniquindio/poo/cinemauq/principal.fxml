<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="520.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.cinemauq.viewController.PrimaryController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <Label text="Cinemauq" />
    <Label text="Sistema de gestión de cinema" />
    <Separator prefWidth="340.0" />
    <VBox prefWidth="340.0" spacing="6.0">
        <Button maxWidth="Infinity" onAction="#onVenta" text="Venta de entrada" />
        <Button maxWidth="Infinity" onAction="#onCancelarVenta" text="Cancelar venta" />
        <Button maxWidth="Infinity" onAction="#onConsultarPeliculas" text="Consultar películas" />
        <Button maxWidth="Infinity" onAction="#onConsultarFunciones" text="Consultar funciones" />
        <Button maxWidth="Infinity" onAction="#onDisponibilidad" text="Consultar disponibilidad" />
        <Button maxWidth="Infinity" onAction="#onAdministrarPeliculas" text="Administrar películas" />
        <Button maxWidth="Infinity" onAction="#onAdministrarFunciones" text="Administrar funciones" />
        <Button maxWidth="Infinity" onAction="#onAdministrarSalas" text="Administrar salas" />
        <Button maxWidth="Infinity" onAction="#onAdministrarClientes" text="Administrar clientes" />
        <Button maxWidth="Infinity" onAction="#onReportes" text="Generar reportes" />
    </VBox>
    <Separator prefWidth="340.0" />
    <Button maxWidth="340.0" onAction="#onSalir" text="Salir" />
</VBox>
